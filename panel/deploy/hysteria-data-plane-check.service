[Unit]
Description=Exercise the authenticated Hysteria2 data plane
After=network-online.target hysteria-server.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/default/hysteria-healthcheck
ExecStart=/usr/local/sbin/hysteria-data-plane-check
StateDirectory=hysteria-healthcheck
StateDirectoryMode=0755
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
